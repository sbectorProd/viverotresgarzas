---
import { getEntry } from "astro:content";

const autoridad = await getEntry("autoridad", "autoridad");

if (!autoridad) {
    throw new Error("Autoridad content not found");
}

const items = autoridad.data.items ?? [];
---

<section class="w-full bg-fondo text-primario py-12 md:py-16 px-6 md:px-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {items.map((item) => (
            <div class="py-8 md:py-10 px-4 text-center">
                <p class="type-brand text-primario">
                    {item.texto}
                </p>
            </div>
        ))}
    </div>
</section>
