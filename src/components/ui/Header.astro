---
import { menú } from "@/constants.ts";
import MobileMenu from "@/components/ui/MobileMenu.astro";
import Logo from "@/components/ui/svg/Logo.astro";
---

<header
    id="site-header"
    class="fixed top-0 left-0 w-full z-50 px-4 sm:px-6 md:px-12 py-4 md:py-4 flex justify-between items-center transition-all duration-300 bg-transparent"
>
    <a
        href="/#inicio"
        id="site-logo"
        class="flex items-center gap-2 sm:gap-4 lg:gap-6 transition-colors duration-300"
    >
        <Logo class="w-6 sm:w-8 lg:w-10 h-auto" />
        <span id="logo-span-2" class="type-brand font-bold relative lg:-top-1">TRES GARZAS</span>
        <span id="logo-span-1" class="font-sans type-nav">VIVERO</span>
    </a>

    <nav id="site-nav" class="hidden md:flex gap-8 lg:gap-12 type-nav">
        {
            menú.map((item) => (
                <a
                    href={`/${item.href}`}
                    class="hover:opacity-70"
                    data-nav-link={item.href.slice(1)}
                >
                    {item.name}
                </a>
            ))
        }
    </nav>

    <button
        id="menu-btn"
        class="md:hidden flex flex-col gap-1.5"
        aria-label="Abrir menú de navegación"
    >
        <span id="hamburger-bar-1" class="w-6 h-0.5"></span>
        <span id="hamburger-bar-2" class="w-6 h-0.5"></span>
        <span id="hamburger-bar-3" class="w-6 h-0.5"></span>
    </button>

    <MobileMenu open={false} />
</header>

<script>
    const header = document.getElementById("site-header");
    const siteLogo = document.getElementById("site-logo");
    const nav = document.getElementById("site-nav");
    const navLinks = document.querySelectorAll("[data-nav-link]");
    const btn = document.getElementById("menu-btn");
    const closeBtn = document.getElementById("close-menu-btn");
    const menu = document.querySelector("[data-mobile-menu]");
    const hamburgerBars = [
        document.getElementById("hamburger-bar-1"),
        document.getElementById("hamburger-bar-2"),
        document.getElementById("hamburger-bar-3"),
    ];
    const sections = document.querySelectorAll("section[id]");
    const scrollRoot = document.querySelector("main");
    const trackedIds = new Set(["nosotros", "servicios", "contacto"]);
    const welcomeSection = document.getElementById("inicio");

    let open = false;
    const visibilityById = new Map();
    let currentSection = welcomeSection ? "inicio" : "";

    const setMenuOpen = (value: boolean) => {
        open = value;

        if (menu) {
            menu.classList.toggle("opacity-0", !open);
            menu.classList.toggle("pointer-events-none", !open);
        }
    };

    btn?.addEventListener("click", (event) => {
        event.stopPropagation();
        setMenuOpen(!open);
    });

    closeBtn?.addEventListener("click", (event) => {
        event.stopPropagation();
        setMenuOpen(false);
    });

    menu?.addEventListener("click", (event) => {
        if (event.target instanceof HTMLElement) {
            const link = event.target.closest("a");
            if (link) setMenuOpen(false);
        }
    });

    document.addEventListener("click", (event) => {
        if (!open || !menu) return;

        if (
            event.target instanceof Node &&
            !menu.contains(event.target) &&
            !btn?.contains(event.target)
        ) {
            setMenuOpen(false);
        }
    });

    const setHeaderTheme = (isWelcome: boolean) => {
        if (header) {
            header.classList.toggle("bg-transparent", isWelcome);
            header.classList.toggle("bg-fondo", !isWelcome);
        }

        const logoClass = isWelcome ? "text-fondo" : "text-primario";
        const navClass = isWelcome ? "text-fondo" : "text-primario";
        const hamburgerClass = isWelcome ? "bg-fondo" : "bg-primario";

        if (siteLogo) {
            siteLogo.classList.remove("text-fondo", "text-primario");
            siteLogo.classList.add(logoClass);
        }

        if (nav) {
            nav.classList.remove("text-fondo", "text-primario");
            nav.classList.add(navClass);
        }

        hamburgerBars.forEach((bar) => {
            if (bar) {
                bar.classList.remove("bg-fondo", "bg-primario");
                bar.classList.add(hamburgerClass);
            }
        });
    };

    const setActiveLink = (sectionId: string) => {
        navLinks.forEach((link) => {
            link.classList.remove("is-active");
            link.removeAttribute("aria-current");
        });

        if (!sectionId || !trackedIds.has(sectionId)) return;

        navLinks.forEach((link) => {
            if (
                link instanceof HTMLElement &&
                link.dataset.navLink === sectionId
            ) {
                link.classList.add("is-active");
                link.setAttribute("aria-current", "page");
            }
        });
    };

    const updateHeaderTheme = () => {
        setHeaderTheme(currentSection === "inicio");
    };

    // Scroll threshold logic: change header when scrolling down
    const SCROLL_THRESHOLD = 80;
    let isScrolled = false;

    const onScroll = () => {
        const scrollTop = scrollRoot?.scrollTop || 0;
        const shouldBeScrolled = scrollTop > SCROLL_THRESHOLD;

        if (shouldBeScrolled !== isScrolled) {
            isScrolled = shouldBeScrolled;
            if (isScrolled) {
                setHeaderTheme(false); // Show solid header when scrolled
            } else {
                updateHeaderTheme(); // Restore theme based on section
            }
        }
    };

    if (sections.length && scrollRoot) {
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    const section = entry.target;
                    visibilityById.set(
                        section.id,
                        entry.isIntersecting ? entry.intersectionRatio : 0,
                    );
                });

                let mostVisibleId = welcomeSection ? "inicio" : "";
                let maxRatio = -1;

                visibilityById.forEach((ratio, id) => {
                    if (ratio > maxRatio) {
                        mostVisibleId = id;
                        maxRatio = ratio;
                    }
                });

                currentSection = mostVisibleId;
                setActiveLink(mostVisibleId);
                if (!isScrolled) updateHeaderTheme();
            },
            {
                root: scrollRoot,
                threshold: [0, 0.25, 0.5, 0.75, 1],
            },
        );

        sections.forEach((section) => observer.observe(section));
        updateHeaderTheme();
        
        // Attach scroll listener for threshold-based header change
        scrollRoot.addEventListener("scroll", onScroll);
        onScroll(); // Initial check in case page is loaded with scroll position
    } else {
        setHeaderTheme(false);
    }
</script>
