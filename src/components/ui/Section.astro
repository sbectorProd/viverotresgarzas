---
type Align = "start" | "center" | "end";
type Snap = "start" | "center" | "end" | "none";

interface Props {
  id?: string;
  align?: Align;
  justify?: Align;
  snap?: Snap;
  bg?: string;
  text?: string;
  className?: string;
  fullscreen?: boolean;
  clip?: boolean;
}

const {
  id,
  align = "start",
  justify = "end",
  snap = "end",
  bg = "bg-fondo",
  text = "text-primario",
  className = "",
  fullscreen = false,
  clip = false,
} = Astro.props as Props;

const alignMap: Record<Align, string> = {
  start: "items-start",
  center: "items-center",
  end: "items-end",
};

const justifyMap: Record<Align, string> = {
  start: "justify-start",
  center: "justify-center",
  end: "justify-end",
};

const snapMap: Record<Snap, string> = {
  start: "snap-start",
  center: "snap-center",
  end: "snap-end",
  none: "snap-none",
};

const snapClass = snapMap[snap];
const clipClass = clip ? "overflow-hidden" : "";
const tallMobileClass = !fullscreen ? "tall-mobile-natural" : "";

const sectionClasses = fullscreen
  ? `relative h-[calc(100vh-63px)] md:h-[calc(100vh-83px)] w-full flex ${alignMap[align]} ${justifyMap[justify]} ${snapClass} ${clipClass} ${bg} ${text} ${className}`
  : `relative min-h-dvh w-full flex ${alignMap[align]} ${justifyMap[justify]} py-6 sm:py-8 md:py-12 px-6 md:px-12 pt-20 md:pt-24 ${snapClass} ${clipClass} ${bg} ${text} ${tallMobileClass} ${className}`;
---

<section
  id={id}
  class={sectionClasses}
>
  <slot />
</section>

<style>
  @media (min-height: 750px) {
    :global(.tall-mobile-natural) {
      min-height: 80vh !important;
    }
  }
</style>
