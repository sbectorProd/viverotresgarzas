---
interface Props {
  href?: string;
  target?: string;
  variant?: "outline" | "solid" | "inverse" | "solidInverse";
  className?: string;
}

const {
  href,
  target,
  variant = "outline",
  className = "",
} = Astro.props as Props;

const base =
  "inline-flex items-center justify-center rounded-full transition-all duration-300 px-4 py-2 type-body md:px-5 md:py-2.5 lg:px-6 lg:py-2.5";

const variants = {
  outline:
    "border border-primario text-primario hover:bg-primario hover:text-fondo",
  solid: "bg-primario text-fondo hover:bg-[#2a472a]",
  inverse: "border border-fondo text-fondo hover:bg-fondo hover:text-primario",
  solidInverse: "bg-fondo text-primario border border-transparent hover:border hover:border-fondo hover:bg-transparent hover:text-fondo",
};
---

{
  href ? (
    <a
      href={href}
      target={target}
      class={`${base} ${variants[variant]} ${className} font-serif`}
    >
      <slot />
    </a>
  ) : (
    <button class={`${base} ${variants[variant]} ${className} font-serif`}>
      <slot />
    </button>
  )
}
