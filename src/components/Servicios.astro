---
import Section from "@/components/ui/Section.astro";
import Container from "@/components/ui/Container.astro";
import { getEntry } from "astro:content";

const servicios = await getEntry("servicios", "servicios");

if (!servicios) {
    throw new Error("servicios content not found");
}

const projects = servicios.data.servicios_lista ?? [];
---

<Section id="servicios" align="start" justify="center" className="xl:px-10 2xl:px-12">
    <Container className="w-full max-w-full">
        <!-- Encabezado -->
        <div class="mb-10 lg:mb-14 lg:pt-32">
            <h2 class="type-h2 text-primario max-w-lg">
                {servicios.data.encabezado}
            </h2>
        </div>

        <!-- Layout: imagen izquierda, servicios derecha -->
        <div class="flex flex-col md:flex-row gap-10 lg:gap-14 xl:gap-18 2xl:gap-24 items-start">
            <!-- Imagen -->
            {servicios.data.imagen && (
                <div class="w-full md:w-[43%] lg:w-[42%] xl:w-[40%] 2xl:w-[39%] shrink-0">
                    <img
                        src={servicios.data.imagen}
                        alt="Servicios Vivero Tres Garzas"
                        class="w-full h-auto max-h-300 object-cover rounded-3xl"
                        width="600"
                        height="400"
                        loading="lazy"
                    />
                </div>
            )}

            <!-- Lista de servicios -->
            <div class="flex flex-col gap-10 xl:gap-14 md:w-[57%] lg:w-[58%] xl:w-[60%] 2xl:w-[61%]">
                {projects.map((servicio) => (
                    <div class="flex gap-8 lg:gap-10 xl:gap-16 items-start">
                        <span class="size-4 lg:size-8 rounded-full bg-primario shrink-0 mt-2 lg:mt-3"></span>
                        <div>
                            <p class="type-h2 text-primario mb-2">
                                {servicio.titulo}
                            </p>
                            <p class="type-body text-primario/80">
                                {servicio.descripcion}
                            </p>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </Container>
</Section>
