---
import Section from "@/components/ui/Section.astro";
import Button from "@/components/ui/Button.astro";
import LogoWA from "@/components/ui/svg/LogoWA.astro";
import LogoContacto from "@/components/ui/svg/LogoContacto.astro";
import { getEntry } from "astro:content";

const contacto = await getEntry("contacto", "contacto");
const personas = contacto?.data?.personas ?? [];
const titulo = contacto?.data?.titulo ?? "Contáctanos";
const whatsapp = contacto?.data?.whatsapp ?? "";
---

<Section
	id="contacto"
	align="end"
	justify="start"
	className="text-primario relative overflow-hidden"
>
	<div class="mx-auto w-full space-y-8 px-1 sm:px-0 lg:mb-12 mt-48">
		<!-- Cabecera -->
		<div class="flex items-center gap-6 lg:gap-36 pb-8">
			<h2 class="type-h1">{titulo}</h2>
			{
				whatsapp && (
					<a
						href={`https://wa.me/${whatsapp}?text=Hola,%20quiero%20más%20información%20del%20vivero%20Tres%20Garzas`}
						target="_blank"
						rel="noopener"
						aria-label="Contáctanos por WhatsApp"
						class="hover:scale-110 transition"
					>
						<LogoWA class="size-6 lg:size-10 text-primario" />
					</a>
				)
			}
		</div>

		<!-- Bloque de personas de contacto -->
		<div class="grid gap-8 md:grid-cols-3 mb-8">
			{
				personas.map((persona) => (
					<div class="flex flex-col gap-2">
						<p class="type-body font-serif font-semibold text-primario">
							{persona.nombre}
						</p>
						{persona.cargo && (
							<p class="type-label text-primario/70">
								{persona.cargo}
							</p>
						)}
						{persona.telefono && persona.telefonoLink && (
							<a
								href={`tel:${persona.telefonoLink}`}
								class="type-label text-primario hover:text-primario/70 transition"
							>
								{persona.telefono}
							</a>
						)}
						{persona.email && (
							<a
								href={`mailto:${persona.email}`}
								class="type-label text-primario hover:text-primario/70 transition break-all"
							>
								{persona.email}
							</a>
						)}
					</div>
				))
			}
		</div>

		<!-- Divisor -->
		<hr id="cotizar-proyecto" class="border-primario/20 my-8" />
		<p class="type-h2 pb-2 md:pb-4">
			Cotiza tu proyecto y descarga nuestro catálogo completo
		</p>
		<!-- Formulario original (sin cambios) -->
		<form
			class="grid gap-6 max-w-4xl"
			method="POST"
			action="/Gracias"
			data-netlify="true"
			name="contacto"
		>
			<input type="hidden" name="form-name" value="contacto" />
			<div class="grid gap-6 md:grid-cols-2">
				<label class="block type-label text-primario/80">
					NOMBRE COMPLETO*
					<input
						type="text"
						name="nombre"
						required
						class="mt-2 w-full rounded-2xl border-3 border-current/30 bg-transparent px-4 py-3 type-label text-primario outline-none transition focus:border-primario focus:ring-2 focus:ring-primario/10"
					/>
				</label>

				<label class="block type-label text-primario/80">
					CORREO ELECTRÓNICO*
					<input
						id="correo"
						name="correo"
						type="email"
						required
						class="mt-2 w-full rounded-2xl border-3 border-current/30 bg-transparent px-4 py-3 type-label text-primario outline-none transition focus:border-primario focus:ring-2 focus:ring-primario/10"
					/>
				</label>
				<label class="block type-label text-primario/80">
					TELÉFONO*
					<input
						type="text"
						name="telefono"
						required
						class="mt-2 w-full rounded-2xl border-3 border-current/30 bg-transparent px-4 py-3 type-label text-primario outline-none transition focus:border-primario focus:ring-2 focus:ring-primario/10"
					/>
				</label>
				<label class="block type-label text-primario/80">
					TIPO DE PROYECTO*
					<select
						name="tipo"
						required
						class="mt-2 w-full rounded-2xl border-3 border-current/30 bg-transparent px-4 py-3 type-label text-primario outline-none transition focus:border-primario focus:ring-2 focus:ring-primario/10"
					>
						<option value="">Selecciona una opción</option>
						<option value="Desarrollo inmobiliario"
							>Desarrollo inmobiliario</option
						>
						<option value="Obra pública">Obra pública</option>
						<option value="Residencial/Casa habitación"
							>Residencial/Casa habitación</option
						>
						<option value="Paisajismo profesional"
							>Paisajismo profesional</option
						>
						<option value="Reforestación">Reforestación</option>
						<option value="Otro">Otro</option>
					</select>
				</label>
			</div>

			<label class="block type-label text-primario/80">
				VOLUMEN APROXIMADO*
				<select
					name="volumen"
					required
					class="mt-2 w-full rounded-2xl border-3 border-current/30 bg-transparent px-4 py-3 type-label text-primario outline-none transition focus:border-primario focus:ring-2 focus:ring-primario/10"
				>
					<option value="">Selecciona una opción</option>
					<option value="1-10 árboles">1-10 árboles</option>
					<option value="10-50 árboles">10-50 árboles</option>
					<option value="50-200 árboles">50-200 árboles</option>
					<option value="200+ árboles">200+ árboles</option>
				</select>
			</label>

			<label class="block type-label text-primario/80">
				MENSAJE
				<textarea
					name="mensaje"
					rows="5"
					class="mt-2 w-full rounded-2xl border-3 border-current/30 bg-transparent px-4 py-3 type-label text-primario outline-none transition focus:border-primario focus:ring-2 focus:ring-primario/10 resize-none"
				></textarea>
			</label>
			<div class="pt-2">
				<Button variant="solid">→ Enviar y descargar catálogo</Button>
			</div>
		</form>
	</div>
	<!-- Logo de huella dactilar en esquina inferior derecha -->
	<!-- <div class="absolute bottom-6 right-6 pointer-events-none">
		<LogoContacto class="w-12 sm:w-32 text-primario" />
	</div> -->
</Section>
