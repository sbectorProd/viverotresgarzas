---
import Layout from "@/layouts/Layout.astro";
import About from "@/components/About.astro";
import Contacto from "@/components/Contacto.astro";
import Servicios from "@/components/Servicios.astro";
import Inicio from "@/components/Inicio.astro";
import ButtonWASticky from "@/components/ui/ButtonWASticky.astro";
---

<Layout
	title="Vivero Tres Garzas | Árboles de gran formato para proyectos paisajísticos"
	description="Vivero especializado en árboles de gran formato para proyectos paisajísticos, urbanísticos y residenciales. Selección técnica, sanidad, logística y plantación."
	canonical="https://viverotresgarzas.com/"
	robots="index,follow"
	ogImage="/EMIF9426.webp"
>
	<main class="h-dvh overflow-y-scroll snap-y snap-proximity">
		<Inicio/>
		<About/>
		<Servicios/>
		<Contacto/>
	</main>
	<ButtonWASticky />
</Layout>