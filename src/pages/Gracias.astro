---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/ui/Section.astro";
import Button from "@/components/ui/Button.astro";
---

<Layout
  title="Gracias por contactarnos | Vivero Tres Garzas"
  description="Hemos recibido tu mensaje. Nuestro equipo revisará tu solicitud y se pondrá en contacto contigo pronto."
  robots="noindex,follow"
  canonical="https://viverotresgarzas.com/Gracias"
>
  <Section align="center" justify="center" className="flex flex-col py-20 px-4">
    <h1 class="type-h1 mb-6 text-green-900">¡Gracias por tu mensaje!</h1>
    <p class="type-body mb-8 text-green-800 pt-0 md:pt-8 md:text-center">
      Hemos recibido tu mensaje y nos pondremos en contacto contigo pronto.<br
      />Mientras tanto, puedes descargar nuestro catálogo o seguir explorando nuestro sitio.
    </p>
    <div class="space-y-4 md:space-y-0 md:flex md:gap-8 pt-0 md:pt-16">
      <Button href="/TRES_GARZAS.pdf" target="_blank">
        → Descargar catálogo</Button
      >
      <Button href="/"> → Volver al inicio</Button>
    </div>
  </Section>
</Layout>
