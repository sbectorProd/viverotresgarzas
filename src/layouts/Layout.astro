---
import "@/styles/global.css";
import Header from "@/components/ui/Header.astro";
import UnderConstructionBanner from "@/components/UnderConstructionBanner.astro";

export interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	robots?: string;
	ogImage?: string;
	jsonLd?: any;
	showHeader?: boolean;
}

const {
	title = "Vivero Tres Garzas | Árboles de gran formato para proyectos paisajísticos",
	description = "Vivero especializado en árboles de gran formato para proyectos paisajísticos, urbanísticos y residenciales. Selección técnica, sanidad, logística y plantación.",
	canonical = "https://viverotresgarzas.com/",
	robots = "index,follow",
	ogImage = "/EMIF9426.webp",
	jsonLd = null,
	showHeader = true
} = Astro.props as Props;

---

<!doctype html>
<html lang="es">
	<head>
		<!-- Google Tag Manager -->
		<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
		new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
		j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
		'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
		})(window,document,'script','dataLayer','GTM-5MSD2FCV');</script>
		<!-- End Google Tag Manager -->
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<link rel="canonical" href={canonical} />
		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content="es_MX" />
		<meta property="og:url" content={canonical} />
		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		{jsonLd && (
			<script type="application/ld+json">{JSON.stringify(jsonLd)}</script>
		)}
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5MSD2FCV"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		{/* <UnderConstructionBanner /> */}
		{showHeader && <Header />}
		<slot />
	</body>
</html>
